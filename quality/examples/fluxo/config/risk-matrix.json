    { "level": "alto", "reason": "novo trigger Firestore (verifique se não escreve na coleção observada → loop)", "globs": ["functions/src/**"], "netIncrease": { "trigger Firestore": "onDocument(Written|Created|Updated|Deleted)\\(|firestore\\s*\\.\\s*document\\(" } },
