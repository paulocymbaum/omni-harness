  "cost": [
    { "level": "critico", "reason": "recursos de Cloud Run/Cloud SQL alterados (CPU, memória, tier)", "added": ["--cpu[= ]", "--memory[= ]", "\\bcpu\\s*[:=]\\s*[\"']?\\d", "\\bmemory\\s*[:=]\\s*[\"']?\\d", "\\btier\\s*=\\s*\"db-", "--tier[= ]db-", "--concurrency[= ]"] },
    { "level": "alto", "reason": "limites de uso/quotas/rate limit alterados", "added": ["MENU_EXTRACTOR_[A-Z_]*LIMIT", "RateLimiting", "PermitLimit", "SYNC_ALL_LIMIT", "MaximumPoolSize", "_(DAILY|HOURLY|MONTHLY)_LIMIT", "usage_?guard"] },
