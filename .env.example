# .env.example — modelo de variáveis do omni-harness
#
# Como usar: copie para .env.local (token PESSOAL de quem desenvolve; tem precedência)
# ou .env (compartilhado do time). Nenhum dos dois vai para o git.
# Ordem de leitura: ambiente do processo > .env.local > .env (scripts/tracker/load-env.mjs).
# As credenciais JIRA_* são um conjunto: o primeiro arquivo que tiver JIRA_API_TOKEN
# fornece TODAS as JIRA_* (não casa token de uma pessoa com e-mail de outra).

# ── Jira — scripts/tracker (sync-context, backlog mark, test-integracao) ────
# Obrigatórias para o sync com o Jira; sem elas o `mark` avisa e segue local.
JIRA_BASE_URL=https://sua-organizacao.atlassian.net
JIRA_EMAIL=voce@exemplo.com
JIRA_API_TOKEN=troque-pelo-seu-token-pessoal
JIRA_PROJECT_KEY=OFLUXO

# Ajuste fino (opcional): base do backoff de retry para 429/502/503/504 (ms).
# JIRA_RETRY_BASE_MS=1000

# Responsável pelo card: com token do .env.local, quem move o card vira o responsável.
# FLUXO_JIRA_ASSIGN=0 desliga; FLUXO_JIRA_ASSIGN=1 força mesmo com token compartilhado.
# FLUXO_JIRA_ASSIGN=0
# Desliga o autosync de spec → card do Jira (hook sync-spec-jira).
# FLUXO_JIRA_AUTOSYNC=0

# ── Gates e hooks — tudo opcional; default é ligado ─────────────────────────
# Pula os gates de qualidade do pre-commit (NÃO pula a guarda de identidade de main).
# Canonical HARNESS_SKIP_QUALITY_GATES=1 (alias retrocompatível: FLUXO_SKIP_QUALITY_GATES=1).
# HARNESS_SKIP_QUALITY_GATES=1
# Desliga a autocorreção leve de gate/teste no post-edit (canonical HARNESS_AUTOFIX).
# HARNESS_AUTOFIX=0
# Grafo do graphify nos hooks de busca: soft (dica, default), strict, off.
# GRAPHIFY_HOOK_MODE=off
# GRAPHIFY_HOOK_STRICT=0
# Desliga a reescrita de comandos ruidosos pelo rtk.
# RTK_DISABLED=1
# Limpeza de terminais do ciclo Cline: desliga, idade máxima (s) e PIDs preservados.
# CLINE_TERMINAL_CLEANUP=0
# CLINE_TERMINAL_MAX_AGE_SEC=600
# CLINE_KEEP_TERMINAL_PIDS=1234,5678
# Debug do handoff entre subagentes (.claude/.state/handoff-debug.jsonl).
# HANDOFF_DEBUG=1
# Stack trace completo em erros do CLI de backlog.
# QUALITY_STACK=1

# ── Teto de recursos dos gates (quality/config/resources.json) ──────────────
# Aumente só se um gate for encerrado por falta de memória (mensagem tool.oom).
# QUALITY_MEM_MAX_MB=4096
# QUALITY_CPU_QUOTA=4
# QUALITY_WORKERS=4
# Heap por ferramenta Node dentro dos gates (mensagem tool.oomHeap).
# QUALITY_NODE_HEAP_MB=2048
# Timeout de cada medição do lizard por texto (ms).
# QUALITY_LIZARD_TIMEOUT_MS=30000
# Desliga os limites de recursos (uso em CI); não desliga gate.
# QUALITY_RESOURCES=off
# Não usa o lizard (medições de complexidade ficam sem medição — evite).
# QUALITY_NO_LIZARD=1

# ── Toolchain — só se a ferramenta não estiver no PATH ──────────────────────
# JAVA_HOME=/usr/lib/jvm/temurin-21
# DOTNET_ROOT=/usr/share/dotnet

# ── Sem variável: integrações por CLI ────────────────────────────────────────
# GitHub (gh): autentica pelo keyring — `gh auth login`; nenhuma variável aqui.
# graphify: o build do grafo roda offline (--code-only); nenhuma chave.
