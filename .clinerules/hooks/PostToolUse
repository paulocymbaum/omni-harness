#!/usr/bin/env node
// Hook PostToolUse do Cline (precisa ser executável e ter exatamente este nome, sem extensão).
// Delega ao módulo do repo: registra a consulta ao grafo que deu certo (abre a janela de busca
// bruta) e, quando uma spec é gravada, atualiza o card do Jira. Descoberto pela extensão VS Code
// (.clinerules/hooks, exige "Enable Hooks") e pelo CLI/SDK (que também varre .clinerules/hooks).
// Arquivo CommonJS fino para não depender do "type" do package.json; falha aberta.
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');

let out = '{}';
try {
  const input = fs.readFileSync(0, 'utf8');
  const target = path.join(__dirname, '..', '..', 'quality', 'hooks', 'cline-post-tool-use.mjs');
  const r = spawnSync(process.execPath, [target], { input, encoding: 'utf8', timeout: 90000 });
  if (r.status === 0 && r.stdout.trim()) out = r.stdout.trim();
} catch { /* libera */ }
process.stdout.write(out);
