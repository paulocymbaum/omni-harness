#!/usr/bin/env node
// Hook TaskStart do Cline (nome exato, sem extensão, executável). Delega a quality/hooks/cline-lifecycle.mjs, que roda os mesmos
// scripts do Claude Code (SessionStart/Stop). Arquivo CommonJS fino; falha aberta.
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
// Limpeza de terminais (Cline >10 min, manual >1 h): roda em todo evento do Cline, silenciosa e melhor-esforço.
try { spawnSync(process.execPath, [path.join(__dirname, '..', '..', 'quality', 'hooks', 'cline-terminal-cleanup.mjs')], { timeout: 15000 }); } catch { /* melhor-esforço */ }

let out = '{}';
try {
  const input = fs.readFileSync(0, 'utf8');
  const target = path.join(__dirname, '..', '..', 'quality', 'hooks', 'cline-lifecycle.mjs');
  const r = spawnSync(process.execPath, [target, path.basename(__filename)], { input, encoding: 'utf8', timeout: 115000 });
  if (r.status === 0 && r.stdout.trim()) out = r.stdout.trim();
} catch { /* libera */ }
process.stdout.write(out);
